# Copy this file to .env and fill in your own values.
# .env is gitignored -- it never ends up in the repo.

LLM_BASE_URL=https://your-endpoint.example.com/v1
LLM_API_KEY=sk-...
LLM_MODEL_NAME=local-devstral-small2

# Optional: model used for the VISUAL (image) comparison. Any OpenAI-compatible
# vision model on the same endpoint works (image_url message parts). Defaults to
# LLM_MODEL_NAME if unset -- local-devstral-small2 (via Ollama) is multimodal and
# handles the page-image comparison in this demo.
# LLM_VISION_MODEL_NAME=local-devstral-small2

# The tool also accepts the CADS-Demo wrapper's variable names as a fallback, so
# either naming works: LITELLM_BASE_URL / LITELLM_API_KEY / LITELLM_DEFAULT_MODEL.
# The base URL may be given with or without a trailing /v1.
